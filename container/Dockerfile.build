# Build stage using Docker (has network access)
FROM swift:6.2.3 AS builder

WORKDIR /build

# Copy package files
COPY Package.swift Package.resolved ./
COPY Sources ./Sources
COPY Tests ./Tests

# Build release binary
RUN swift build -c release --target NanoClawAgent

# Runtime stage - minimal image just to extract binary
FROM swift:6.2.3-slim

# Copy the dynamically-linked binary from builder
COPY --from=builder /build/.build/release/nanoclaw-agent /app/nanoclaw-agent

# Create output directory
RUN mkdir -p /output

# Copy binary to output for extraction
CMD ["cp", "/app/nanoclaw-agent", "/output/nanoclaw-agent"]
