# NanoClawSwift Agent - Slim Container
# Builds the Linux binary in a Swift Linux builder image to avoid apt/dns setup.

FROM swift:6.2.3 AS builder

WORKDIR /build

COPY Package.swift Package.resolved ./
COPY Sources ./Sources

RUN swift build -c release --target NanoClawAgent

FROM swift:6.2.3-slim

# NOTE: Avoid apt-get in container build to prevent DNS issues in Apple containers.
# The swift:6.2.3-slim image already includes CA certificates.

# Create working directory
WORKDIR /app

# Create non-root user with specific UID
RUN id -u nanoclaw >/dev/null 2>&1 || useradd -m -s /bin/bash nanoclaw && \
    mkdir -p /workspace/group /workspace/ipc/messages /workspace/ipc/tasks /workspace/sessions && \
    chown -R nanoclaw:nanoclaw /workspace && \
    chmod 750 /workspace && \
    chmod 750 /workspace/group && \
    chmod 750 /workspace/ipc && \
    chmod 750 /workspace/ipc/messages && \
    chmod 750 /workspace/ipc/tasks && \
    chmod 750 /workspace/sessions

# Copy the Swift binary from build stage
COPY --from=builder --chown=nanoclaw:nanoclaw /build/.build/release/nanoclaw-agent /app/nanoclaw-agent

# Set environment
ENV SWIFT_BACKTRACE=none
ENV ASSISTANT_NAME=Andy

# Switch to non-root user
USER nanoclaw

# Entry point
ENTRYPOINT ["/app/nanoclaw-agent"]
